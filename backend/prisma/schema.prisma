generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  DOCTOR
  RECEPTIONIST
  DISPENSER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TokenStatus {
  WAITING
  CALLED
  CONSULTING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  WAITING
  CONSULTING
  PRESCRIPTION_READY
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  READY
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum DispensingType {
  NEW_PRESCRIPTION
  REPEAT
}

enum DispensingStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELLED
}

enum PaymentTiming {
  BEFORE_CONSULTATION
  AFTER_CONSULTATION
  AT_DISPENSING
}

enum RepeatRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClinicPlan {
  FREE
  STARTER
  CLINIC
  PRO
}

model Clinic {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  logoUrl   String?    @map("logo_url")
  timezone  String     @default("Asia/Karachi")
  currency  String     @default("PKR")
  isActive  Boolean    @default(true) @map("is_active")
  plan      ClinicPlan @default(FREE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  users            User[]
  doctors          Doctor[]
  patients         Patient[]
  tokens           Token[]
  visits           Visit[]
  prescriptions    Prescription[]
  medicines        Medicine[]
  dispensings      Dispensing[]
  payments         Payment[]
  auditLogs        AuditLog[]
  settings         ClinicSettings?
  sequences        ClinicSequence?
  refreshTokens    RefreshToken[]
  favoriteMedicines DoctorFavoriteMedicine[]
  repeatRequests   RepeatRequest[]

  @@map("clinics")
}

model User {
  id           String    @id @default(uuid())
  clinicId     String    @map("clinic_id")
  name         String
  phone        String?
  email        String?
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  canDispense  Boolean   @default(false) @map("can_dispense")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  clinic           Clinic                   @relation(fields: [clinicId], references: [id])
  doctor           Doctor?
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  dispensings      Dispensing[]
  repeatRequests   RepeatRequest[]          @relation("RepeatRequestedBy")
  repeatReviews    RepeatRequest[]          @relation("RepeatReviewedBy")

  @@index([clinicId, role])
  @@index([clinicId, email])
  @@index([clinicId, phone])
  @@map("users")
}

model Doctor {
  id               String    @id @default(uuid())
  clinicId         String    @map("clinic_id")
  userId           String    @unique @map("user_id")
  name             String
  licenseNumber    String?   @map("license_number")
  specialization   String?
  consultationFee  Decimal   @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  clinic            Clinic                   @relation(fields: [clinicId], references: [id])
  user              User                     @relation(fields: [userId], references: [id])
  tokens            Token[]
  visits            Visit[]
  prescriptions     Prescription[]
  favoriteMedicines DoctorFavoriteMedicine[]

  @@index([clinicId, isActive])
  @@map("doctors")
}

model Patient {
  id             String    @id @default(uuid())
  clinicId       String    @map("clinic_id")
  patientNumber  String    @map("patient_number")
  name           String
  phone          String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  age            Int?
  gender         Gender?
  address        String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  tokens         Token[]
  visits         Visit[]
  prescriptions  Prescription[]
  dispensings    Dispensing[]
  payments       Payment[]
  repeatRequests RepeatRequest[]

  @@unique([clinicId, patientNumber])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@map("patients")
}

model Token {
  id          String      @id @default(uuid())
  clinicId    String      @map("clinic_id")
  visitId     String?     @unique @map("visit_id")
  patientId   String      @map("patient_id")
  doctorId    String      @map("doctor_id")
  tokenNumber String      @map("token_number")
  tokenDate   DateTime    @map("token_date") @db.Date
  status      TokenStatus @default(WAITING)
  createdAt   DateTime    @default(now()) @map("created_at")
  calledAt    DateTime?   @map("called_at")
  completedAt DateTime?   @map("completed_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  visit   Visit?

  @@unique([clinicId, tokenDate, tokenNumber])
  @@index([clinicId, tokenDate, status])
  @@index([clinicId, doctorId, tokenDate])
  @@map("tokens")
}

model Visit {
  id            String      @id @default(uuid())
  clinicId      String      @map("clinic_id")
  patientId     String      @map("patient_id")
  doctorId      String      @map("doctor_id")
  tokenId       String      @unique @map("token_id")
  complaint     String?
  diagnosis     String?
  clinicalNotes String?     @map("clinical_notes")
  status        VisitStatus @default(WAITING)
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  token         Token          @relation(fields: [tokenId], references: [id])
  prescription  Prescription?
  payments      Payment[]

  @@index([clinicId, doctorId, status])
  @@index([clinicId, patientId, createdAt])
  @@map("visits")
}

model Prescription {
  id                 String             @id @default(uuid())
  clinicId           String             @map("clinic_id")
  patientId          String             @map("patient_id")
  visitId            String             @unique @map("visit_id")
  doctorId           String             @map("doctor_id")
  prescriptionNumber String             @map("prescription_number")
  status             PrescriptionStatus @default(DRAFT)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  clinic     Clinic             @relation(fields: [clinicId], references: [id])
  patient    Patient            @relation(fields: [patientId], references: [id])
  visit      Visit              @relation(fields: [visitId], references: [id])
  doctor     Doctor             @relation(fields: [doctorId], references: [id])
  items      PrescriptionItem[]
  dispensings Dispensing[]
  repeatRequests RepeatRequest[]

  @@unique([clinicId, prescriptionNumber])
  @@index([clinicId, patientId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                    String   @id @default(uuid())
  prescriptionId        String   @map("prescription_id")
  medicineId            String   @map("medicine_id")
  medicineNameSnapshot  String   @map("medicine_name_snapshot")
  genericNameSnapshot   String?  @map("generic_name_snapshot")
  strengthSnapshot      String?  @map("strength_snapshot")
  formSnapshot          String?  @map("form_snapshot")
  dose                  String
  doseQuantity          Decimal  @map("dose_quantity") @db.Decimal(10, 2)
  frequency             String
  frequencyPerDay       Decimal  @map("frequency_per_day") @db.Decimal(10, 2)
  durationDays          Int      @map("duration_days")
  quantity              Int
  instructions          String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  prescription    Prescription     @relation(fields: [prescriptionId], references: [id])
  medicine        Medicine         @relation(fields: [medicineId], references: [id])
  dispensingItems DispensingItem[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

model Medicine {
  id                 String    @id @default(uuid())
  clinicId           String    @map("clinic_id")
  name               String
  genericName        String?   @map("generic_name")
  strength           String?
  form               String?
  unit               String    @default("Tablet")
  sellingPrice       Decimal   @map("selling_price") @db.Decimal(12, 2)
  stockQuantity      Int       @default(0) @map("stock_quantity")
  lowStockThreshold  Int       @default(10) @map("low_stock_threshold")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  clinic            Clinic                   @relation(fields: [clinicId], references: [id])
  prescriptionItems PrescriptionItem[]
  dispensingItems   DispensingItem[]
  favorites         DoctorFavoriteMedicine[]

  @@index([clinicId, name])
  @@index([clinicId, isActive])
  @@map("medicines")
}

model DoctorFavoriteMedicine {
  id                   String   @id @default(uuid())
  clinicId             String   @map("clinic_id")
  doctorId             String   @map("doctor_id")
  medicineId           String   @map("medicine_id")
  defaultDose          String?  @map("default_dose")
  defaultDoseQuantity  Decimal? @map("default_dose_quantity") @db.Decimal(10, 2)
  defaultFrequency     String?  @map("default_frequency")
  defaultFrequencyPerDay Decimal? @map("default_frequency_per_day") @db.Decimal(10, 2)
  defaultDurationDays  Int?     @map("default_duration_days")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")

  clinic   Clinic  @relation(fields: [clinicId], references: [id])
  doctor   Doctor  @relation(fields: [doctorId], references: [id])
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@unique([doctorId, medicineId])
  @@map("doctor_favorite_medicines")
}

model Dispensing {
  id             String           @id @default(uuid())
  clinicId       String           @map("clinic_id")
  patientId      String           @map("patient_id")
  prescriptionId String           @map("prescription_id")
  type           DispensingType
  status         DispensingStatus @default(PENDING)
  dispensedById  String?          @map("dispensed_by")
  dispensedAt    DateTime?        @map("dispensed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  prescription Prescription     @relation(fields: [prescriptionId], references: [id])
  dispensedBy  User?            @relation(fields: [dispensedById], references: [id])
  items        DispensingItem[]
  payments     Payment[]

  @@index([clinicId, status, createdAt])
  @@index([clinicId, patientId, createdAt])
  @@index([prescriptionId, type])
  @@map("dispensings")
}

model DispensingItem {
  id                 String  @id @default(uuid())
  dispensingId       String  @map("dispensing_id")
  prescriptionItemId String  @map("prescription_item_id")
  medicineId         String  @map("medicine_id")
  quantity           Int
  unitPrice          Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice         Decimal @map("total_price") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  dispensing       Dispensing       @relation(fields: [dispensingId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicine         Medicine         @relation(fields: [medicineId], references: [id])

  @@map("dispensing_items")
}

model Payment {
  id            String        @id @default(uuid())
  clinicId      String        @map("clinic_id")
  patientId     String        @map("patient_id")
  visitId       String?       @map("visit_id")
  dispensingId  String?       @map("dispensing_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  reference     String?
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id])
  visit      Visit?      @relation(fields: [visitId], references: [id])
  dispensing Dispensing? @relation(fields: [dispensingId], references: [id])

  @@index([clinicId, createdAt])
  @@index([clinicId, status])
  @@map("payments")
}

model RepeatRequest {
  id             String               @id @default(uuid())
  clinicId       String               @map("clinic_id")
  patientId      String               @map("patient_id")
  prescriptionId String               @map("prescription_id")
  requestedById  String               @map("requested_by")
  status         RepeatRequestStatus  @default(PENDING)
  reviewedById   String?              @map("reviewed_by")
  reviewedAt     DateTime?            @map("reviewed_at")
  notes          String?
  itemIds        String[]             @map("item_ids")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  requestedBy  User         @relation("RepeatRequestedBy", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("RepeatReviewedBy", fields: [reviewedById], references: [id])

  @@index([clinicId, status])
  @@map("repeat_requests")
}

model ClinicSettings {
  id                           String         @id @default(uuid())
  clinicId                     String         @unique @map("clinic_id")
  clinicName                   String         @map("clinic_name")
  logo                         String?
  address                      String?
  phone                        String?
  prescriptionTemplate         String?        @map("prescription_template")
  currency                     String         @default("PKR")
  timezone                     String         @default("Asia/Karachi")
  consultationFee              Decimal        @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  paymentTiming                PaymentTiming  @default(AT_DISPENSING) @map("payment_timing")
  tokenPrefix                  String         @default("") @map("token_prefix")
  tokenResetDaily              Boolean        @default(true) @map("token_reset_daily")
  repeatMedicineEnabled        Boolean        @default(true) @map("repeat_medicine_enabled")
  repeatRequiresDoctorApproval Boolean        @default(false) @map("repeat_requires_doctor_approval")
  repeatValidityDays           Int            @default(30) @map("repeat_validity_days")
  negativeStockAllowed         Boolean        @default(false) @map("negative_stock_allowed")
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_settings")
}

model ClinicSequence {
  clinicId             String @id @map("clinic_id")
  lastPatientNumber    Int    @default(0) @map("last_patient_number")
  lastPrescriptionNumber Int  @default(0) @map("last_prescription_number")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_sequences")
}

model AuditLog {
  id         String   @id @default(uuid())
  clinicId   String   @map("clinic_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  clinicId  String    @map("clinic_id")
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
